<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prim.Core\Prim.Core.csproj" />
    <ProjectReference Include="..\..\src\Prim.Runtime\Prim.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Prim.Serialization\Prim.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Prim.Roslyn\Prim.Roslyn.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The analyzer is referenced above as an analyzer-only reference (ReferenceOutputAssembly="false")
    so the source generator actually runs against this test project (issue #15). The unit tests in
    this project also exercise the analyzer types directly, so link the analyzer source here to make
    those types available without leaking the netstandard2.0 assembly as a runtime reference.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Prim.Roslyn\YieldPointAnalyzer.cs" Link="Analyzer\YieldPointAnalyzer.cs" />
    <Compile Include="..\..\src\Prim.Roslyn\ContinuationGenerator.cs" Link="Analyzer\ContinuationGenerator.cs" />
  </ItemGroup>

</Project>
